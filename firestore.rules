rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Security Helper Functions
    function isValidPhone(phone) {
      return phone is string && phone.size() >= 10 && phone.size() <= 20;
    }

    function isPositiveAmount(amount) {
      return amount is number && amount >= 0;
    }

    function isNonEmptyString(str) {
      return str is string && str.size() > 0 && str.size() < 1000;
    }

    // 1. Bookings Collection: Real customer bookings with status lifecycle
    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['id', 'customerName', 'status'])
                    && isNonEmptyString(request.resource.data.customerName)
                    && request.resource.data.status in ['requested', 'searching', 'accepted', 'worker_en_route', 'arrived', 'arrived_at_door', 'in_progress', 'completed', 'cancelled'];
      allow update: if request.resource.data.status in ['requested', 'searching', 'accepted', 'worker_en_route', 'arrived', 'arrived_at_door', 'in_progress', 'completed', 'cancelled'];
      allow delete: if true;
    }
    
    // 2. Workers Collection: Worker profile and registration
    match /workers/{workerId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['id', 'name', 'phone'])
                    && isValidPhone(request.resource.data.phone);
      allow update: if true;
      allow delete: if true;
    }

    // 2a. Customers Collection: Customer profile registration
    match /customers/{customerId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['id', 'name'])
                    && isNonEmptyString(request.resource.data.name);
      allow update: if true;
      allow delete: if true;
    }

    // 2b. Jobs Broadcast Collection: Customer broadcast leads
    match /jobs/{jobId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['id', 'title', 'category']);
      allow delete: if true;
    }
    
    // 3. Platform Commissions: Supports pending -> paid / rejected verification lifecycle
    match /commissions/{commissionId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['id', 'workerId', 'commissionAmount', 'bookingId'])
                    && isPositiveAmount(request.resource.data.commissionAmount);
      allow update: if request.resource.data.status in ['paid', 'pending', 'rejected'];
      allow delete: if true;
    }

    // 3a. Worker-to-Owner UPI Payment Verification Claims (12-digit UTR proof)
    match /upi_payment_claims/{claimId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['id', 'workerId', 'purpose', 'amount', 'utrNumber', 'status'])
                    && isPositiveAmount(request.resource.data.amount)
                    && isNonEmptyString(request.resource.data.utrNumber)
                    && request.resource.data.utrNumber.matches('^[0-9]{12}$')
                    && request.resource.data.status == 'pending_verification';
      allow update: if request.resource.data.status in ['pending_verification', 'approved', 'rejected'];
      allow delete: if true;
    }
    
    // 4. Owner Payouts: Bank Withdrawals
    match /owner_payouts/{payoutId} {
      allow read: if true;
      allow create: if isPositiveAmount(request.resource.data.amount);
      allow update: if false;
      allow delete: if true;
    }

    // 5. App Owner Config (UPI & Commission Settings)
    match /app_config/{configId} {
      allow read: if true;
      allow write: if request.resource.data.upiId is string && request.resource.data.upiId.size() > 3;
    }

    // 6. Real-Time Booking Chat Messages
    match /chat_messages/{messageId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['id', 'bookingId', 'senderRole', 'text'])
                    && request.resource.data.senderRole in ['customer', 'worker']
                    && isNonEmptyString(request.resource.data.bookingId)
                    && isNonEmptyString(request.resource.data.text);
      allow update: if false;
      allow delete: if true;
    }

    // 6a. Real-Time WebRTC Call Signaling Sessions
    match /call_sessions/{sessionId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['id', 'bookingId', 'callerRole', 'calleeRole', 'status', 'startedAtMs'])
                    && request.resource.data.callerRole in ['customer', 'worker']
                    && request.resource.data.calleeRole in ['customer', 'worker']
                    && request.resource.data.status in ['ringing', 'connected', 'ended', 'rejected', 'missed']
                    && isNonEmptyString(request.resource.data.bookingId);
      allow update: if request.resource.data.status in ['ringing', 'connected', 'ended', 'rejected', 'missed'];
      allow delete: if true;
    }

    // 7. Connection test ping
    match /_connection_test/{docId} {
      allow read, write: if true;
    }
  }
}
