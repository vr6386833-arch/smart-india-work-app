# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key for live map & routes.
# AI Studio provisions this via Google Maps setup without committing secrets.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# VITE_API_BASE_URL: Live HTTPS backend server URL used inside standalone Android/iOS APK builds.
# Set this before running `npm run build && cap sync android` so APK calls reach your backend.
VITE_API_BASE_URL="https://your-live-backend-url.run.app"

# GOOGLE_MAPS_SERVER_KEY: Optional server-side Google Maps Geocoding key for high-traffic reverse geocoding.
GOOGLE_MAPS_SERVER_KEY="MY_GOOGLE_MAPS_SERVER_KEY"

# TURN_URL / TURN_USERNAME / TURN_CREDENTIAL: Optional WebRTC relay server for 100% voice call reliability on strict 4G/5G CGNAT networks.
TURN_URL="MY_TURN_SERVER_URL"
TURN_USERNAME="MY_TURN_USERNAME"
TURN_CREDENTIAL="MY_TURN_CREDENTIAL"

