{
  "entities": {
    "Booking": {
      "title": "Booking",
      "description": "Customer service booking and worker dispatch with OTP verification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "customerAddress": { "type": "string" },
        "workerId": { "type": "string" },
        "workerName": { "type": "string" },
        "serviceCategory": { "type": "string" },
        "status": { "type": "string", "enum": ["requested", "searching", "accepted", "arrived", "in_progress", "completed", "cancelled"] },
        "arrivalOtp": { "type": "string" },
        "isOtpVerified": { "type": "boolean" },
        "customerLiveLocation": { "type": "object" },
        "workerLiveLocation": { "type": "object" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "customerName", "status"]
    },
    "WorkerProfile": {
      "title": "WorkerProfile",
      "description": "Registered worker profile with wallet, verification, and lock state",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "category": { "type": "string" },
        "walletBalance": { "type": "number" },
        "isBlockedDueToUnpaidFee": { "type": "boolean" },
        "unpaidFeeAmount": { "type": "number" },
        "isAadhaarVerified": { "type": "boolean" }
      },
      "required": ["id", "name", "phone"]
    },
    "CommissionRecord": {
      "title": "CommissionRecord",
      "description": "₹10 per job fee paid by worker via company QR or wallet",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "workerId": { "type": "string" },
        "workerName": { "type": "string" },
        "bookingId": { "type": "string" },
        "commissionAmount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "upiTxnId": { "type": "string" },
        "paidAt": { "type": "string" }
      },
      "required": ["id", "workerId", "commissionAmount", "bookingId"]
    },
    "OwnerPayout": {
      "title": "OwnerPayout",
      "description": "Earnings transferred by app owner to their bank account",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "amount": { "type": "number" },
        "destinationBank": { "type": "string" },
        "accountNumber": { "type": "string" },
        "utrNumber": { "type": "string" },
        "status": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["id", "amount"]
    },
    "CustomerProfile": {
      "title": "CustomerProfile",
      "description": "Registered customer profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "city": { "type": "string" },
        "locality": { "type": "string" },
        "address": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "UpiPaymentRequest": {
      "title": "UpiPaymentRequest",
      "description": "Worker-to-Owner real UPI payment verification request awaiting Owner confirmation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "workerId": { "type": "string" },
        "workerName": { "type": "string" },
        "workerPhone": { "type": "string" },
        "purpose": { "type": "string", "enum": ["wallet", "unpaid_fee", "lead_fee", "kyc", "pro"] },
        "amount": { "type": "number" },
        "utrNumber": { "type": "string", "minLength": 12, "maxLength": 12, "pattern": "^\\d{12}$" },
        "screenshotUrl": { "type": "string" },
        "bookingId": { "type": "string" },
        "commissionId": { "type": "string" },
        "note": { "type": "string" },
        "status": { "type": "string", "enum": ["pending_verification", "approved", "rejected"] },
        "rejectionReason": { "type": "string" },
        "submittedAtMs": { "type": "number" },
        "submittedAtText": { "type": "string" },
        "reviewedAtText": { "type": "string" }
      },
      "required": ["id", "workerId", "purpose", "amount", "utrNumber", "status"]
    },
    "CallSession": {
      "title": "CallSession",
      "description": "Real-time cross-device WebRTC voice call signaling session between customer and worker",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bookingId": { "type": "string" },
        "callerRole": { "type": "string", "enum": ["customer", "worker"] },
        "callerName": { "type": "string" },
        "calleeRole": { "type": "string", "enum": ["customer", "worker"] },
        "calleeName": { "type": "string" },
        "status": { "type": "string", "enum": ["ringing", "connected", "ended", "rejected", "missed"] },
        "offerSdp": { "type": "string" },
        "answerSdp": { "type": "string" },
        "callerCandidates": { "type": "array" },
        "calleeCandidates": { "type": "array" },
        "startedAtMs": { "type": "number" },
        "updatedAtMs": { "type": "number" }
      },
      "required": ["id", "bookingId", "callerRole", "calleeRole", "status", "startedAtMs"]
    }
  },
  "firestore": {
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Collection of customer service bookings"
    },
    "/workers/{workerId}": {
      "schema": { "$ref": "#/entities/WorkerProfile" },
      "description": "Collection of worker profiles"
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/CustomerProfile" },
      "description": "Collection of customer profiles"
    },
    "/commissions/{commissionId}": {
      "schema": { "$ref": "#/entities/CommissionRecord" },
      "description": "Collection of platform fee records"
    },
    "/owner_payouts/{payoutId}": {
      "schema": { "$ref": "#/entities/OwnerPayout" },
      "description": "Collection of owner bank withdrawals"
    },
    "/upi_payment_claims/{claimId}": {
      "schema": { "$ref": "#/entities/UpiPaymentRequest" },
      "description": "Collection of worker UPI UTR payment claims pending owner bank verification"
    },
    "/call_sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/CallSession" },
      "description": "Collection of live WebRTC voice call signaling sessions"
    }
  }
}
